# --- Ghostty 1.3.0 Configuration ---

# ghostty +show-config --default --docs
# ghostty +show-config
#
# Theme & Appearance
theme = light:3024 Day,dark:Broadcast

background-opacity             = 0.8
background-blur                = 90

# Option A: hide all three items on titlebar
macos-titlebar-style           = hidden

# Option B: hide macOS traffic-light buttons and title
#           but the folder icon stays
# macos-window-buttons           = hidden
# title = " "

window-padding-x               = 5
window-padding-y               = 5
window-padding-balance         = true

# Option A: Mixed font for EN and CN
# font-family = NeoXiHei Code
#
# The same font as used in iTerm2, not working in Kitty though
font-family = JetBrains Maple Mono

# Option B: Assign EN and CN fonts separately
# font-family = JetBrainsMonoNL Nerd Font Mono
# Make sure your CN font has italic and bold-italic
# But my PingFang SC does not have italic or bold-italic
# font-family = PingFang SC

# font-codepoint-map = U+23FB-U+23FE,U+2665,U+26A1,U+2B58,U+E000-U+E00A,U+E0A0-U+E0A3,U+E0B0-U+E0D4,U+E200-U+E2A9,U+E300-U+E3E3,U+E5FA-U+E6AA,U+E700-U+E7C5,U+EA60-U+EBEB,U+F000-U+F2E0,U+F300-U+F32F,U+F400-U+F4A9,U+F500-U+F8FF,U+F0001-U+F1AF0=Symbols Nerd Font Mono
# font-codepoint-map = U+4E00-U+9FFF,U+3400-U+4DBF=Maple Mono NF CN


# The cursor-style=block is already the default setting,
# so reset it explicitly here does not give you the block,
# as it appears to be affected by shell-integration-features.
#
# cursor-style                   = block
cursor-style-blink             = false

# Shell Integration
#
# Detect the shell based on the filename - default value
# shell-integration              = detect
#
# This convert the cursor-style from bar to block
shell-integration-features     = no-cursor

copy-on-select                 = clipboard

# Mouse & Integration
mouse-hide-while-typing        = true
mouse-scroll-multiplier        = 2

# Other Configurations
macos-option-as-alt            = true

# --- Keybinds ---
#
# Valid modifiers are `shift`, `ctrl` (alias: `control`), `alt` (alias: `opt`,
# `option`), and `super` (alias: `cmd`, `command`). You may use the modifier
# or the alias. When debugging keybinds, the non-aliased modifier will always
# be used in output.

# These are all default keybinds
# Pasted here for remembering them
# --- A: Core keybinds ---
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+enter=toggle_fullscreen

keybind = super+n=new_window

# When with `macos-titlebar-style = hidden` set,
# `super+t` performs the same as `super+n`
keybind = super+t=new_tab

# When with `macos-titlebar-style = transparent`,
# `super+t` does open new tabs, but appears to
# mess with the AeroSpace window manager,
# and disrupts the correct window layouts
# when switching between tabs.

keybind = super+q=quit


# --- Ghostty 1.3.0 Configuration ---

# ghostty +show-config --default --docs
# ghostty +show-config
#
# Theme & Appearance
#
# The active palette is driven by Quickshell (ThemeState.qml), which writes
# the current theme colors to this file and reloads Ghostty via SIGUSR2.
# Keep the light:/dark: fallbacks below in case Quickshell is not running.
theme = light:3024 Day,dark:Broadcast
config-file = ?themes/dynamic.conf

background-opacity             = 0.8
background-blur                = 90

# Option A: hide all three items on titlebar
macos-titlebar-style           = hidden

# Option B: hide macOS traffic-light buttons and title
#           but the folder icon stays
# macos-window-buttons           = hidden
# title = " "

window-padding-x               = 5
window-padding-y               = 5
window-padding-balance         = true

# Same fonts as used in Kitty
# Primary (Latin): IosevkaTerm Nerd Font Mono
# Fallback (CJK): LXGW WenKai Mono (extra font-family lines act as fallbacks)
font-family = IosevkaTerm Nerd Font Mono
font-family = LXGW WenKai Mono
font-size = 16

# The cursor-style=block is already the default setting,
# so reset it explicitly here does not give you the block,
# as it appears to be affected by shell-integration-features.
#
# cursor-style                   = block
cursor-style-blink             = false

# Shell Integration
#
# Detect the shell based on the filename - default value
# shell-integration              = detect
#
# This convert the cursor-style from bar to block
shell-integration-features     = no-cursor

copy-on-select                 = clipboard

# Mouse & Integration
mouse-hide-while-typing        = true
mouse-scroll-multiplier        = 2

# Other Configurations
macos-option-as-alt            = true
working-directory              = ~

# Close windows/tabs without the "Close Window?" confirmation dialog
confirm-close-surface          = false

# --- Keybinds ---
#
# Valid modifiers are `shift`, `ctrl` (alias: `control`), `alt` (alias: `opt`,
# `option`), and `super` (alias: `cmd`, `command`). You may use the modifier
# or the alias. When debugging keybinds, the non-aliased modifier will always
# be used in output.
#
# `super` key on macOS: `cmd` or `command`
# `super` key on Arch Linux: 
# - `Windows` key on Lenovo Windows laptop orignal keyboard
# - `System` key on external SKN 4.0 keyboard

# I use AeroSpace on macOS, and Hyprland on Arch Linux as the window manager
# keybinds defined inside Ghostty and AeroSpace sometimes conflict with each other 
# keybinds defined inside Ghostty and Hyprland sometimes conflict with each other 
# 
# Because windown manager is sitting at the outer layer of the terminal Ghostty
# if you have the same set of keybinds defined for AeroSpace or Hyprland
# they will take precedance at the window manager level
#
# The core set below is aligned with Kitty (ctrl+shift namespace).
# Everything Hyprland's SUPER+letter/SHIFT/CTRL+SHIFT scheme shadows is gone;
# the remaining super chords below are ones Hyprland does not grab.
# ===== Aligned core (shared with Kitty, ctrl+shift namespace) =====
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+enter=new_split:down
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+q=quit
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+a=select_all
keybind = ctrl+shift+k=clear_screen
keybind = ctrl+shift+f=toggle_fullscreen
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+0=reset_font_size
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+1=goto_tab:1
keybind = ctrl+shift+2=goto_tab:2
keybind = ctrl+shift+3=goto_tab:3
keybind = ctrl+shift+4=goto_tab:4
keybind = ctrl+shift+5=goto_tab:5
keybind = ctrl+shift+6=goto_tab:6
keybind = ctrl+shift+7=goto_tab:7
keybind = ctrl+shift+8=goto_tab:8
keybind = ctrl+shift+9=goto_tab:9
keybind = ctrl+shift+page_up=scroll_page_up
keybind = ctrl+shift+page_down=scroll_page_down
keybind = ctrl+shift+home=scroll_to_top
keybind = ctrl+shift+end=scroll_to_bottom

# ===== Extras (terminal-specific, on chords Hyprland does not grab) =====
# mac-parity quit (also available); super+q is not used by Hyprland
keybind = super+q=quit
# was super+shift+p, which Hyprland shadows with the active-window screenshot
keybind = ctrl+shift+p=toggle_command_palette
# quick terminal requires the `global:` prefix to work outside the window
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# split / tab navigation
keybind = super+bracket_left=goto_split:previous
keybind = super+bracket_right=goto_split:next
keybind = super+shift+bracket_left=previous_tab
keybind = super+shift+bracket_right=next_tab
keybind = super+alt+arrow_left=goto_split:left
keybind = super+alt+arrow_right=goto_split:right
keybind = super+alt+arrow_up=goto_split:up
keybind = super+alt+arrow_down=goto_split:down
keybind = super+alt+w=close_tab:this
keybind = super+alt+shift+w=close_all_windows
keybind = super+shift+enter=toggle_split_zoom
keybind = super+ctrl+equal=equalize_splits

# split resize (reachable; Hyprland only grabs SUPER+CTRL+SHIFT+hjkl)
keybind = super+ctrl+arrow_left=resize_split:left,10
keybind = super+ctrl+arrow_right=resize_split:right,10
keybind = super+ctrl+arrow_up=resize_split:up,10
keybind = super+ctrl+arrow_down=resize_split:down,10

# prompt navigation (Ghostty-only, not in Kitty)
keybind = super+arrow_up=jump_to_prompt:-1
keybind = super+arrow_down=jump_to_prompt:1
keybind = super+shift+arrow_up=jump_to_prompt:-1
keybind = super+shift+arrow_down=jump_to_prompt:1

# config + misc
keybind = super+,=open_config
keybind = super+shift+,=reload_config
keybind = super+alt+i=inspector:toggle
keybind = super+alt+shift+j=write_screen_file:open
keybind = super+ctrl+shift+j=write_screen_file:copy
keybind = super+arrow_left=text:\\x01
keybind = super+arrow_right=text:\\x05
keybind = alt+arrow_left=esc:b
keybind = alt+arrow_right=esc:f

# ===== Selection (shift-only, passed through to the shell) =====
keybind = shift+page_up=adjust_selection:page_up
keybind = shift+page_down=adjust_selection:page_down
keybind = shift+arrow_up=adjust_selection:up
keybind = shift+arrow_down=adjust_selection:down
keybind = shift+arrow_left=adjust_selection:left
keybind = shift+arrow_right=adjust_selection:right
keybind = shift+home=adjust_selection:home
keybind = shift+end=adjust_selection:end

# ===== Unmodified (mouse-based) =====
keybind = copy=copy_to_clipboard
keybind = paste=paste_from_clipboard

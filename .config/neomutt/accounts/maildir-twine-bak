# If you want to sync your mails to the local storage
# I want to save the emails locally starting 2026
# And then in in 2027 I can revise the folder name to twine-2026
# and keep using the "twine" folder for 2027 and onwards
set folder = "~/.maildir/twine"
set mbox_type = maildir

set spool_file = "+INBOX"
set move = no

# initial mailboxes
set postponed = "+Drafts"
set trash = "+Trash"
set record = "+Sent"



# Account 1: mailboxes and folder hook
mailboxes -label R:Inbox -notify -poll ~/.maildir/twine/INBOX \
          -label R:Drafts -nonotify -poll ~/.maildir/twine/Drafts \
          -label R:Sent -nonotify -poll ~/.maildir/twine/Sent \
          -label R:Trash -nonotify -nopoll ~/.maildir/twine/Trash

folder-hook ~/.maildir/twine/ 'source ~/.config/neomutt/accounts/twine'

# mailboxes in the sidebar
mailboxes "+INBOX" "+Sent" "+Drafts" "+Trash"


# vim: set filetype=neomuttrc:
# NeoMutt configuration for Twine account (alowree@twineintl.com)
# Local Maildir sync via mbsync

# ------------------------------------------------------------------------------
# Identity & Authentication
# ------------------------------------------------------------------------------
set from            = "alowree@twineintl.com"
set real_name       = "Alowree Xu - Twine"
set imap_user       = $from
set smtp_url        = "smtps://alowree@twineintl.com@ud.1025.hk:465"
set smtp_authenticators = "login"

# Password from macOS keychain
# set imap_pass       = `security find-generic-password -a 'alowree@twineintl.com' -s 'neomutt-twine' -w`
# set smtp_pass       = `security find-generic-password -a 'alowree@twineintl.com' -s 'neomutt-twine' -w`

set imap_pass       = `pass Email/twineintl` 
set smtp_pass       = `pass Email/twineintl`

# ------------------------------------------------------------------------------
# Mail Storage (Local Maildir)
# ------------------------------------------------------------------------------
set folder          = "~/.maildir/twine"
set mbox_type       = maildir
set spool_file      = "+INBOX"
set move            = no

# Standard folders
set postponed       = "+Drafts"
set trash           = "+Trash"
set record          = "+Sent"
set signature       = "~/.config/neomutt/accounts/twine-signature"

# ------------------------------------------------------------------------------
# Mailboxes (Sidebar)
# ------------------------------------------------------------------------------
# Active folders (polled for new mail)
mailboxes -label "📥 INBOX"   -notify -poll "+INBOX"

# Standard folders (no poll, shown in sidebar)
mailboxes -label "📤 Sent"    -nonotify "+Sent" \
          -label "📝 Drafts"  -nonotify "+Drafts" \
          -label "🗑️ Trash"   -nonotify "+Trash"

# Archive folders (local only, no sync)
mailboxes -label "📁 2025"    -nonotify "~/.maildir/2025" \
          -label "📁 2026"    -nonotify "~/.maildir/2026"

# ------------------------------------------------------------------------------
# Folder Hooks (per-folder settings)
# ------------------------------------------------------------------------------
# Apply twine account settings when in twine folders
folder-hook ~/.maildir/twine/ 'source ~/.config/neomutt/accounts/twine'

# Optional: different signature for replies from archive
# folder-hook ~/.maildir/2025/ 'set signature="~/.config/neomutt/accounts/twine-archive-signature"'
# folder-hook ~/.maildir/2026/ 'set signature="~/.config/neomutt/accounts/twine-archive-signature"'

# ------------------------------------------------------------------------------
# Macros for Quick Archive Access
# ------------------------------------------------------------------------------
# Press '25' to go to 2025 archive, '26' for 2026
bind index,pager 2 noop
macro index,pager 25 "<change-folder>~/.maildir/2025<enter>" "Go to 2025 archive"
macro index,pager 26 "<change-folder>~/.maildir/2026<enter>" "Go to 2026 archive"

# ------------------------------------------------------------------------------
# Notes
# ------------------------------------------------------------------------------
# - Archives (2025, 2026) are local-only, not synced via mbsync
# - To create new archive: mkdir -p ~/.maildir/2027/{cur,new,tmp}
# - Then add: mailboxes -label "📁 2027" -nonotify "~/.maildir/2027"

# vim: set filetype=neomuttrc:
# NeoMutt Twine Account Selector
# Choose between local (maildir) and remote (IMAP) modes

# ------------------------------------------------------------------------------
# Mode Selection - Uncomment ONE line to switch modes
# ------------------------------------------------------------------------------
# twine-local  → Uses ~/.maildir/twine (fast, offline-capable)
# twine-remote → Uses IMAP server      (slow, always synced)

source ~/.config/neomutt/accounts/twine-local
# source ~/.config/neomutt/accounts/twine-remote

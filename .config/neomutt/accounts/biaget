# vim: filetype=muttrc
# unmailboxes *

# ------------------------------------------------------------------------------
# Identity
# ------------------------------------------------------------------------------

set from = "alowree@biaget.com"
set realname = "Alowree Xu - Biaget"

# ------------------------------------------------------------------------------
# SMTP
# ------------------------------------------------------------------------------
set smtp_url = "smtps://alowree@biaget.com@smtp.263.net:465"
set smtp_authenticators = "login"

# Path to pass on macOS and Arch Linux
set my_pass_bin     = `command -v pass`

# Set initial passwords (these work on first load)
set imap_pass = "`$my_pass_bin Email/biaget`"
set smtp_pass = "`$my_pass_bin Email/biaget`"

# Folder settings
set folder = "imaps://alowree@biaget.com@imap.263.net:993"
set spoolfile = "+Inbox"

# When switching to this account via folder change, re-evaluate passwords
# This ensures the correct password is used if anything changes
# account-hook $folder "set imap_pass=`$my_pass_bin Email/biaget` smtp_pass=`$my_pass_bin Email/biaget`"
account-hook $folder "set imap_pass=\"\`$my_pass_bin Email/biaget\`\" smtp_pass=\"\`$my_pass_bin Email/biaget\`\""

set envelope_from = yes
set use_from = yes
# set record = "+Sent"
set record = "+已发送"
# set trash = "+Deleted Items"
set trash = "+已删除"
# set postponed = "+Drafts"
set postponed = "+草稿箱"
set mail_check = 6

mailboxes "+Inbox" "+已发送" "+草稿箱" "+已删除"

# Allow Mutt to open a new IMAP connection automatically.
unset imap_passive

# Keep the IMAP connection alive by polling intermittently (time in seconds).
set imap_keepalive = 300

# Signature
set signature = "~/.config/neomutt/accounts/biaget-signature"

# vim: set filetype=neomuttrc:

# Official manual page
# https://neomutt.org/guide/reference#2-%C2%A0configuration-commands

# TODO: To complete the review from this user vegarkarlsen
# 2026-01-23
# https://github.com/vegarkarlsen/neomuttrc/blob/main/neomuttrc
#
# set help
# set help = yes
#
# unset help                           # No help bar at the top of Index
# set help = no                        # No help bar at the top of Index

###############################################################################
# EDITOR AND COMPOSITION
###############################################################################
set editor = "nvim"
set edit_headers                     # show headers when composing
set ask_cc                           # prompt you for carbon-copy recipients

set forward_format = "Fwd: %s"       # format of subject when forwarding
set forward_quote                    # include message in forwards
set forward_decode                   # decode when forwarding


set reply_to                         # reply to Reply to: field
set fast_reply                       # skip to compose when replying
set include                          # include message in replies
set attribution_intro = "On %d, %n wrote:" # format of quoting header
set sig_dashes = no                  # no default `-- ` dashes before signature
set sig_on_top = yes                 # signature shall always stick to your email body
set text_flowed = yes
set fcc_attach                       # save attachments with the body

###############################################################################
# DISPLAY AND PAGER
###############################################################################
set pager_index_lines = 10           # show 10 lines of Index when Pager is active
set pager_context = 5                # lines of context between pages
set pager_stop                       # Don't skip to next when we get to end of message

set smart_wrap                       # wrap lines at word boundaries rather than splitting up words
set wrap = 90                        # email view width
set tilde                            # Show ~ at end of message

set markers = no                     # do not show plus sign for wrapped lines in the pager
set allow_ansi                       # Allow ANSI codes in messages
set arrow_cursor = "no"              # Use block cursor
set menu_scroll                      # scroll in menus

# Main options

set imap_check_subscribed

set beep_new                         # bell on new mails

set pipe_decode                      # strip headers and eval mimes when piping
set use_envelope_from                # TODO: not sure what this is about
set collapse_all
set uncollapse_jump
set sleep_time = 0                   # Pause 0 seconds for informational messages
set mark_old = yes                   # marking new, unread emails as old when you exit a mailbox
set wait_key = no                    # NeoMutt won't ask "press any key to continue"


set date_format = "%d.%m.%Y %H:%M"


# Modern setup UTF-8 everywhere
set charset = "utf-8"               # is about YOUR environment
set send_charset = "utf-8"          # is about OTHERS' ability to read
set assumed_charset = ""            # is about OTHERS' mistakes (missing charset)

set reply_regex = "^(([Rr][Ee]?(\[[0-9]+\])?: *)?(\[[^]]+\] *)?)*"
set quote_regex = "^( {0,4}[>|:#%]| {0,4}[a-z0-9]+[>|]+)+"

#If you:
# Have separate email accounts (e.g., Gmail, Work, Personal)
# Each account has its own NeoMutt configuration/profile
# Don't forward emails between accounts
# Reply from the same account you received the email in
# Then you should NOT use reverse_name or reverse_real_name at all.
# set reverse_name                     # Try to guess which addres we should use for From: by using alternates

set count_alternatives = yes         # recurse into text/multipart when looking for attachment types
set auto_tag                         # automatically apply commands to all tagged messages
set auto_subscribe
set flag_safe                        # flagged messages can't be deleted

set browser_sort = alpha         # Controls how mailboxes/folders are sorted in the sidebar or folder browser

### index sorting
# set use_threads = reverse
# set sort = last-date
set sort = reverse-date

### sidebar
# set sidebar_visible
set sidebar_sort = unread       # Why these two configuration commands are in WHITE?
set sidebar_width = 30
set sidebar_next_new_wrap = yes

set sidebar_format = "%B %<N?(%N)>%* %S"
set sidebar_folder_indent = no
set sidebar_short_path = yes



### headers TODO: What are these?
ignore *
unignore from: to: cc: date: subject: x-label:
unhdr_order *
hdr_order from: to: cc: date: subject: x-label:

### Attachments
set mime_type_query_command = "file --mime-type -b %s"
# set display_filter = "tac | sed '/\\\[-- Autoview/,+1d' | tac"
# auto_view application/ics
# auto_view text/calendar
# auto_view text/plain
# auto_view text/html
# auto_view application/pgp-encrypted
# alternative_order text/calendar text/html text/enriched text/plain text/*

# Set preferred view modes (used before but now replaced by the upper section)
# view html automatically
auto_view text/html text/calendar application/ics
alternative_order text/html text/plain text/enriched text/*

set mail_check = 120
set timeout = 30
set mail_check_stats = yes
set mail_check_stats_interval = 120

set imap_idle = yes

### These are the settings not categorized yet


set confirm_append = no      # don't ask, just do!
set quit                     # don't ask, just do!
set thorough_search          # strip headers and eval mimes before searching

# Status bar, date format, finding stuff etc.
set status_chars = " *%A"
set status_format = "[ Folder: %f ] [%r%m messages%?n? (%n new)?%?d? (%d to delete)?%?t? (%t tagged)? ]%>─%?p?( %p postponed )?"

set charset = "utf-8"

# Caching headers and bodies
set header_cache = ~/.cache/neomutt/headers
set message_cache_dir = ~/.cache/neomutt/bodies

set header_cache_compress_method = "zlib"
set header_cache_compress_level = 3

set message_cache_clean = yes                   # not recommended to set this!

set tmp_dir = /tmp/$USER/neomutt

set query_command = "khard email --parsable --search-in-source-files '%s'"


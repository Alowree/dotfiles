# twine ========================================================
# 1. Configure the remote server
IMAPAccount twine
Host twineintlcom.securemail.hk
User alowree@twineintl.com
# Works on macOS only
# PassCmd "security find-generic-password -a 'alowree@twineintl.com' -s 'neomutt-twine' -w"
#
# On macOS, it tries the absolute Homebrew path first. If it exists, it runs.
#
# On Arch Linux, the first part fails silently (command not found),
# and it falls back to just the latter part
# (which will be in the standard /usr/bin path)
PassCmd "/opt/homebrew/bin/pass Email/twineintl || pass Email/twineintl"
Port 993
TLSType IMAPS
AuthMechs PLAIN
# SystemCertificates no
# CertificateFile ~/.maildir/certificates/root-certificates.pem

# 2. Configure the remote store
IMAPStore twine-remote
Account twine

# 3. Configure the local mail store
MaildirStore twine-local
Path ~/.maildir/twine/
Inbox ~/.maildir/twine/INBOX
SubFolders Verbatim

# 4. Connect them with a channel
# Channel connecting <acount-name>-remote to <acount-name>-local
Channel twine
Far :twine-remote:
Near :twine-local:
Patterns *
Sync All
Expunge Both
Create Near
Remove Near
SyncState *
CopyArrivalDate yes
ExpireUnread yes
# ==============================================================

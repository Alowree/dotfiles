# List all fonts Kitty can find by `kitty +list-fonts`

# font_family      family="JetBrainsMono Nerd Font Mono"
font_family      family="JetBrains Maple Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto

# Without explicitly configuring CJK characters,
# what's the default font for Chinese?

# Force to use Maple Mono for CJK characters
# BUT DOES NOT SEEM TO WORK
symbol_map             U+4E00-U+9FFF,U+3400-U+4DBF Maple Mono NF CN
# Force to use Symbols Nerd Font for Nerd Font symbols
symbol_map             U+23FB-U+23FE,U+2665,U+26A1,U+2B58,U+E000-U+E00A,U+E0A0-U+E0A3,U+E0B0-U+E0D4,U+E200-U+E2A9,U+E300-U+E3E3,U+E5FA-U+E6AA,U+E700-U+E7C5,U+EA60-U+EBEB,U+F000-U+F2E0,U+F300-U+F32F,U+F400-U+F4A9,U+F500-U+F8FF,U+F0001-U+F1AF0 Symbols Nerd Font Mono

font_size        13
# modify_font cell_height 120%

# Text cursor customization
cursor_shape                 block
shell_integration            no-cursor
cursor_blink_interval        0

cursor_trail                 3
cursor_trail_decay           0.1 0.4
cursor_trail_start_threshold 2

# Window layout
hide_window_decorations    titlebar-only
background_opacity         0.95
background_tint            0.99
window_padding_width       1 4 4

remember_window_size  yes
initial_window_width  960
initial_window_height 600

# Color scheme
# background_image ~/.config/wallpapers/cold_rain.jpg
background_image_layout cscaled

# include themes/Catppuccin-Mocha.conf
include themes/tokyonight_night.conf

# OS specific tweaks
macos_option_as_alt yes

include mappings.conf

# BEGIN_KITTY_THEME
# Apprentice
include current-theme.conf
# END_KITTY_THEME

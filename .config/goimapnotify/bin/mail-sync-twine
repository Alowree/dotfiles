#!/bin/bash
# mail-sync-twine - Cross-platform email sync script for Twine account
# Works on macOS and Arch Linux
# Location: ~/.local/bin/mail-sync-twine

# Set up logging
LOG_FILE="/tmp/mail-sync-twine.log"
DEBUG=true  # Set to false to disable debug logging

# Logging function
log() {
    local level="$1"
    shift
    local message="$*"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    if [[ "$DEBUG" == true ]]; then
        echo "[$timestamp] [$level] $message" >> "$LOG_FILE"
    fi
    
    # Also output to stderr for manual runs
    if [[ -t 1 ]]; then
        echo "[$level] $message"
    fi
}

# Detect operating system
detect_os() {
    case "$(uname -s)" in
        Darwin)
            echo "macos"
            ;;
        Linux)
            echo "linux"
            ;;
        *)
            echo "unknown"
            ;;
    esac
}

# Find executable with fallback paths
find_executable() {
    local cmd="$1"
    local os="$2"
    
    # Define paths based on OS
    case "$os" in
        macos)
            local paths=(
                "/opt/homebrew/bin/$cmd"
                "/usr/local/bin/$cmd"
                "/usr/bin/$cmd"
            )
            ;;
        linux)
            local paths=(
                "/usr/sbin/$cmd"      # Common on Arch for some binaries
                "/usr/bin/$cmd"
                "/usr/local/bin/$cmd"
            )
            ;;
        *)
            local paths=(
                "/usr/bin/$cmd"
                "/usr/local/bin/$cmd"
            )
            ;;
    esac
    
    # Check each path
    for path in "${paths[@]}"; do
        if [[ -x "$path" ]]; then
            echo "$path"
            return 0
        fi
    done
    
    # Fallback to PATH lookup
    if command -v "$cmd" >/dev/null 2>&1; then
        command -v "$cmd"
        return 0
    fi
    
    # Not found
    echo ""
    return 1
}

# Send desktop notification
send_notification() {
    local title="$1"
    local message="$2"
    local os="$3"
    
    case "$os" in
        macos)
            if command -v terminal-notifier >/dev/null 2>&1; then
                terminal-notifier -title "$title" -message "$message" -sound default
            else
                osascript -e "display notification \"$message\" with title \"$title\" sound name \"default\""
            fi
            ;;
        linux)
            if command -v notify-send >/dev/null 2>&1; then
                notify-send -t 5000 -u normal "$title" "$message"
            elif command -v dunstify >/dev/null 2>&1; then
                dunstify -t 5000 "$title" "$message"
            else
                echo -e "\a"  # Terminal bell
                log "WARN" "No notification daemon found"
            fi
            ;;
    esac
}

# Check for new mail
check_new_mail() {
    local maildir="$1"
    local new_count=0
    
    if [[ -d "$maildir/INBOX/new" ]]; then
        new_count=$(find "$maildir/INBOX/new" -type f -cmin -1 | wc -l)
    fi
    
    echo "$new_count"
}

# Main sync function
sync_mail() {
    local os="$1"
    local mbsync_path="$2"
    local notmuch_path="$3"
    
    log "INFO" "Starting mail sync on $(uname -s)"
    
    # Run mbsync
    if [[ -n "$mbsync_path" ]] && [[ -x "$mbsync_path" ]]; then
        log "INFO" "Running mbsync: $mbsync_path twine"
        "$mbsync_path" twine
        local mbsync_exit=$?
        
        if [[ $mbsync_exit -eq 0 ]]; then
            log "INFO" "mbsync completed successfully"
        else
            log "ERROR" "mbsync failed with exit code: $mbsync_exit"
            return 1
        fi
    else
        log "ERROR" "mbsync not found"
        return 1
    fi
    
    # Update notmuch index if available
    if [[ -n "$notmuch_path" ]] && [[ -x "$notmuch_path" ]]; then
        log "INFO" "Updating notmuch index"
        "$notmuch_path" new
    else
        log "DEBUG" "notmuch not found, skipping index update"
    fi
    
    # Check for new mail
    local new_count=$(check_new_mail "$HOME/.maildir/twine")
    if [[ $new_count -gt 0 ]]; then
        log "INFO" "Detected $new_count new message(s)"
        # Return 0 to indicate new mail was found (will trigger notification)
        return 0
    else
        log "DEBUG" "No new mail detected"
        return 1
    fi
}

# Main execution
main() {
    # Detect OS
    OS=$(detect_os)
    log "INFO" "Detected OS: $OS"
    
    # Find required executables
    MBSYNC_PATH=$(find_executable "mbsync" "$OS")
    NOTMUCH_PATH=$(find_executable "notmuch" "$OS")
    PASS_PATH=$(find_executable "pass" "$OS")
    
    # Log found paths
    log "DEBUG" "mbsync path: ${MBSYNC_PATH:-NOT FOUND}"
    log "DEBUG" "notmuch path: ${NOTMUCH_PATH:-NOT FOUND}"
    log "DEBUG" "pass path: ${PASS_PATH:-NOT FOUND}"
    
    # Validate required executables
    if [[ -z "$MBSYNC_PATH" ]]; then
        log "ERROR" "mbsync not found. Please install isync package."
        log "ERROR" "macOS: brew install isync"
        log "ERROR" "Arch: sudo pacman -S isync"
        exit 1
    fi
    
    # Run sync
    if sync_mail "$OS" "$MBSYNC_PATH" "$NOTMUCH_PATH"; then
        # New mail was found, send notification
        log "INFO" "Sending new mail notification"
        send_notification "Twine Mail" "New email received" "$OS"
    fi
    
    log "INFO" "Mail sync completed"
}

# Run main function
main "$@"

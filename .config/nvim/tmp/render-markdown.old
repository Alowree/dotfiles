-- https://github.com/patricorgi/dotfiles/blob/main/.config/nvim/after/ftplugin/markdown.lua
-- My preference - better no text glitches when with cursor on/off the current line
-- - [x] inline code
-- - [x] H1-H6 headings
-- - [x] ordered list
-- - [x] unordered list
-- - [ ] check list
-- - [ ] links
-- - [ ] bold text
-- - [ ] italic text
return {
	"MeanderingProgrammer/render-markdown.nvim",
	-- language_icon for Markdown files rendered as a big downward arrow
	-- therefore abandoned
	dependencies = { "nvim-treesitter/nvim-treesitter", "nvim-tree/nvim-web-devicons" },
	-- dependencies = { { "echasnovski/mini.icons", opts = {} } },
	---@module 'render-markdown'
	---@type render.md.UserConfig
	opts = {
		-- Vim modes that will show a rendered view of the markdown file, :h mode(), for all enabled
		-- components. Individual components can be enabled for other modes. Remaining modes will be
		-- unaffected by this plugin.
		render_modes = { "n", "c", "t" },
		-- Whether markdown should be rendered when nested inside markdown,
		-- i.e. markdown code block inside markdown file.
		nested = false,
		-- no signs on the gutter
		sign = { enabled = false },
		code = {
			-- inline code
			inline = true,
			inline_pad = 1,
			-- code block
			border = "thin",
			position = "right",
			width = "block",
			min_width = 80,
			-- language info
			language_icon = true,
			language_name = true,
			above = "▁",
			below = "▔",
			language_left = "█",
			language_right = "█",
			language_border = "▁",
			left_pad = 0,
			right_pad = 0,
		},
		heading = {
			icons = { "󰼏 ", " 󰎨 ", " 󰼑 ", " 󰎲 ", " 󰼓 ", " 󰎴 " },
			render_modes = true, -- keep rendering while inserting
		},
		checkbox = {
			unchecked = {
				icon = "   󰄱 ",
				highlight = "RenderMarkdownCodeFallback",
				scope_highlight = "RenderMarkdownCodeFallback",
			},
			checked = {
				icon = "   󰄵 ",
				highlight = "RenderMarkdownUnchecked",
				scope_highlight = "RenderMarkdownUnchecked",
			},
			custom = {
				question = {
					raw = "[?]",
					rendered = "    ",
					highlight = "RenderMarkdownError",
					scope_highlight = "RenderMarkdownError",
				},
				todo = {
					raw = "[>]",
					rendered = "   󰦖 ",
					highlight = "RenderMarkdownInfo",
					scope_highlight = "RenderMarkdownInfo",
				},
				canceled = {
					raw = "[-]",
					rendered = "    ",
					highlight = "RenderMarkdownCodeFallback",
					scope_highlight = "@text.strike",
				},
				important = {
					raw = "[!]",
					rendered = "    ",
					highlight = "RenderMarkdownWarn",
					scope_highlight = "RenderMarkdownWarn",
				},
				favorite = {
					raw = "[~]",
					rendered = "    ",
					highlight = "RenderMarkdownMath",
					scope_highlight = "RenderMarkdownMath",
				},
			},
		},
		pipe_table = {
			alignment_indicator = "─",
			border = { "╭", "┬", "╮", "├", "┼", "┤", "╰", "┴", "╯", "│", "─" },
		},
		link = {
			wiki = { icon = " ", highlight = "RenderMarkdownWikiLink", scope_highlight = "RenderMarkdownWikiLink" },
			image = " ",
			custom = {
				github = { pattern = "github", icon = " " },
				gitlab = { pattern = "gitlab", icon = "󰮠 " },
				youtube = { pattern = "youtube", icon = " " },
				cern = { pattern = "cern.ch", icon = " " },
			},
			hyperlink = " ",
		},
		anti_conceal = {
			-- Modes to disable anti conceal feature.
			-- Meaning in Normal mode it is all rendered
			disabled_modes = { "n" },
			ignore = {
				head_border = true,
				head_background = true,
			},
		},
		-- https://github.com/MeanderingProgrammer/render-markdown.nvim/issues/509
		win_options = {
			-- Window options to use that change between rendered and raw view.

			-- @see :h 'conceallevel'
			conceallevel = {
				-- Used when not being rendered, get user setting.
				default = vim.o.conceallevel,
				-- Used when being rendered, concealed text is completely hidden.
				rendered = 3,
			},
			-- @see :h 'concealcursor'
			concealcursor = {
				-- Used when not being rendered, get user setting.
				default = vim.o.concealcursor,
				-- Used when being rendered, show concealed text in all modes.
				-- rendered = "",
				rendered = "nvc",
			},
		},
		completions = {
			blink = { enabled = true },
			lsp = { enabled = true },
		},
	},
}

return {
	"folke/tokyonight.nvim",
	lazy = false,
	priority = 1000,
	style = "storm", -- Choose between "storm", "moon", "night", or "day"
	on_highlights = function(hl, c)
		-- Bold Text (Strong)
		-- Using c.orange or c.red1 makes the bold font stand out significantly
		hl["@markup.strong.markdown_inline"] = { fg = c.red, bold = true }

		-- Italic Text (Emphasis) - Optional extra
		hl["@markup.italic.markdown_inline"] = { fg = c.magenta, italic = true }

		-- Blockquotes
		-- hl["@markup.quote.markdown"] = { fg = c.comment, italic = false }
		hl["@markup.quote.markdown"] = { fg = c.dark5, italic = false }

		-- Links
		-- hl["@markup.link.label.markdown"] = { fg = c.blue1 }
		-- hl["@markup.link.url.markdown"] = { fg = c.teal, underline = true }

		-- Inline Code
		hl["@markup.raw.inline.markdown"] = { fg = c.green, bg = c.bg_highlight }
	end,
	config = function(_, opts)
		-- 1. Run the standard setup with the opts table above
		require("tokyonight").setup(opts)

		-- 2. Activate the theme
		vim.cmd.colorscheme("tokyonight-storm")
	end,
}

return {
	"luukvbaal/statuscol.nvim",
	config = function()
		local builtin = require("statuscol.builtin")
		require("statuscol").setup({
			relculright = true, -- Make relative numbers right-aligned
			segments = {
				-- Segment 1: Fold Column (The Icons)
				{
					text = { builtin.foldfunc }, -- This calls the logic for your fold icons
					click = "v:lua.ScFa", -- Makes the icons clickable!
				},
				-- Segment 2: Sign Column (Git signs, Diagnostics)
				{
					sign = { name = { ".*" }, maxwidth = 1, colwidth = 1 },
					click = "v:lua.ScSa",
				},
				-- Segment 3: Line Numbers
				{
					text = { builtin.lnumfunc, " " }, -- Line number + a space
					click = "v:lua.ScLa",
				},
			},
		})
	end,
}

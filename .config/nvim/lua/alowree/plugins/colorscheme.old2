return {
	{
		"rebelot/kanagawa.nvim",
		-- Kanagawa handles light/dark natively via 'wave' and 'lotus'
	},
	{
		"ellisonleao/gruvbox.nvim",
	},

	-- tokyonight {{{
	{
		"folke/tokyonight.nvim",
		priority = 1000,
		config = function()
			local transparent = true

			-- 1. Define Dual Color Sets
			local dark_palette = {
				bg = "#011628",
				bg_dark = "#011423",
				bg_highlight = "#143652",
				bg_search = "#0A64AC",
				bg_visual = "#275378",
				fg = "#CBE0F0",
				fg_dark = "#B4D0E9",
				fg_gutter = "#627E97",
				border = "#547998",
			}

			local light_palette = {
				bg = "#f6f8fa", -- Clean light background
				bg_dark = "#e1e4e8",
				bg_highlight = "#d1d5da",
				bg_search = "#fff5b1",
				bg_visual = "#c8e1ff",
				fg = "#24292e",
				fg_dark = "#586069",
				fg_gutter = "#959da5",
				border = "#e1e4e8",
			}

			require("tokyonight").setup({
				-- 2. Style will switch between 'storm' and 'day' based on system
				style = vim.o.background == "dark" and "storm" or "day",
				transparent = transparent,
				styles = {
					sidebars = transparent and "transparent" or "dark",
					floats = transparent and "transparent" or "dark",
				},
				on_colors = function(colors)
					-- Select the appropriate palette
					local p = vim.o.background == "dark" and dark_palette or light_palette

					colors.bg = p.bg
					colors.bg_dark = transparent and colors.none or p.bg_dark
					colors.bg_float = transparent and colors.none or p.bg_dark
					colors.bg_highlight = p.bg_highlight
					colors.bg_popup = p.bg_dark
					colors.bg_search = p.bg_search
					colors.bg_sidebar = transparent and colors.none or p.bg_dark
					colors.bg_statusline = transparent and colors.none or p.bg_dark
					colors.bg_visual = p.bg_visual
					colors.border = p.border
					colors.fg = p.fg
					colors.fg_dark = p.fg_dark
					colors.fg_float = p.fg
					colors.fg_gutter = p.fg_gutter
					colors.fg_sidebar = p.fg_dark
				end,
				on_highlights = function(hl, c)
					-- Unified Markdown Styling that adapts to the chosen theme colors
					local header_colors = { c.blue, c.orange, c.green, c.cyan, c.magenta, c.purple }
					for i, color in ipairs(header_colors) do
						hl["@markup.heading." .. i .. ".markdown"] = { bg = "NONE", bold = true, fg = color }
					end

					hl["@markup.strong.markdown_inline"] = { fg = c.red, bold = true }
					hl["@markup.italic.markdown_inline"] = { fg = c.magenta, italic = true }
					hl["@markup.quote.markdown"] = { fg = c.comment }

					-- Dynamic fold background
					hl.Folded = {
						bg = vim.o.background == "dark" and "#1a1b26" or "#e1e4e8",
						fg = c.blue,
					}
				end,
			})

			vim.cmd("colorscheme tokyonight")
		end,
	},
	-- }}}

	-- catppuccin {{{
	{
		"catppuccin/nvim",
		name = "catppuccin",
		priority = 1000,
		config = function()
			require("catppuccin").setup({
				transparent_background = true,
				-- Catppuccin flavor auto-detection
				background = {
					light = "latte",
					dark = "frappe",
				},
				highlight_overrides = {
					all = function(colors)
						return {
							-- Using internal 'colors' variable ensures these work in light/dark
							["@markup.heading.1.markdown"] = { fg = colors.red, style = { "bold" } },
							["@markup.heading.2.markdown"] = { fg = colors.peach, style = { "bold" } },
							["@markup.heading.3.markdown"] = { fg = colors.yellow, style = { "bold" } },
							["@markup.heading.4.markdown"] = { fg = colors.green, style = { "bold" } },
							["@markup.heading.5.markdown"] = { fg = colors.blue, style = { "bold" } },
							["@markup.heading.6.markdown"] = { fg = colors.mauve, style = { "bold" } },
							["@markup.quote.markdown"] = { fg = colors.rosewater },
						}
					end,
				},
			})
		end,
	},
	-- }}}
}
-- vim: foldmethod=marker:
